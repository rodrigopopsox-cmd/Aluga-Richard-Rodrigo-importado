# Supabase — copie este arquivo para `.env.local` e preencha.
#
# O `.env.local` NUNCA vai para o git: o `.gitignore` ignora `.env*`.
# Este exemplo é o único arquivo de ambiente versionado, e não tem valor.

# URL do projeto. Painel do Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon). Pode ir no navegador — quem a tem só alcança o que
# as políticas de RLS deixarem, e as 17 tabelas têm RLS ativo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A chave `service_role` NÃO vai aqui. Ela ignora o RLS. Se um dia for
# necessária, fica só no servidor e sem o prefixo NEXT_PUBLIC_.
